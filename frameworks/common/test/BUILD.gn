import("//build/test.gni")
import("//foundation/distributeddatamgr/kv_store/kv_store.gni")
import("//foundation/distributeddatamgr/kv_store/kv_store_deps.gni")

module_output_path = "kv_store/kv_store/common"

###############################################################################
config("module_private_config") {
  visibility = [ ":*" ]

  cflags = [ "-Wno-c99-designator" ]

  include_dirs = [
    "../",
    "${kv_store_base_path}/interfaces/innerkits/distributeddata/include",
  ]
}

###############################################################################
ohos_unittest("ConcurrentStripedMapTest") {
  module_out_path = module_output_path

  sources = [ "concurrent_striped_map_test.cpp" ]

  configs = [ ":module_private_config" ]

  external_deps = [
    "c_utils:utils",
    "googletest:gtest",
  ]

}

