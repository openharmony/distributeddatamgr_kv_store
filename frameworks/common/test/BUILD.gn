    "googletest:gtest",
  ]
  external_deps += external_deps_safwk
  external_deps += external_deps_hilog
  external_deps += external_deps_ipc_single
  external_deps += external_deps_samgr

  deps = []
  deps += deps_hilog
  deps += deps_ipc_single
  deps += deps_safwk
  deps += deps_samgr
}

