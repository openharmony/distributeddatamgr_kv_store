import("//build/test.gni")
import("//foundation/distributeddatamgr/kv_store/kv_store.gni")
import("//foundation/distributeddatamgr/kv_store/kv_store_deps.gni")

module_output_path = "kv_store/kv_store/distributeddatafwk"

###############################################################################
config("module_private_config") {
  visibility = [ ":*" ]

  cflags = [ "-Wno-c99-designator" ]

  include_dirs = [
    "../include/",
    "../src/",
    "../../crypt/",
    "../../datashare/",
    "../../dm/",
    "../../dms/",
    "../../distributeddatasvc/include/",
    "../../kvdb/include/",
    "../../kvdb/src/",
    "../../../common/",
    "../../../../interfaces/innerkits/distributeddata/include/",
    "../../../../interfaces/innerkits/distributeddatamgr/include/",

    # for ipc_core interfaces.
    "//foundation/distributeddatamgr/kv_store/interfaces/innerkits/distributeddata/include",
  ]
}

###############################################################################
ohos_source_set("distributeddatafwk_src_file") {
  testonly = true

  old_sources = [
    "../../distributeddatasvc/src/datamgr_service_proxy.cpp",
    "../../distributeddatasvc/src/distributed_data_mgr.cpp",
    "../../distributeddatasvc/src/kvstore_data_service_mgr.cpp",
    "../src/blob.cpp",
    "../src/change_notification.cpp",
    "../src/data_query.cpp",
    "../src/distributed_kv_data_manager.cpp",
    "../src/ikvstore_client_death_observer.cpp",
    "../src/ikvstore_observer.cpp",
    "../src/kvdb_notifier_client.cpp",
    "../src/kvdb_notifier_stub.cpp",
    "../src/kvstore_client_death_observer.cpp",
    "../src/kvstore_observer_client.cpp",
    "../src/kvstore_service_death_notifier.cpp",
    "../src/switch_observer_bridge.cpp",
    "../src/sync_observer.cpp",
  ]

  if (data_share_enabled) {
    old_sources += [
      "../../datashare/kv_utils.cpp",
      "../../datashare/kvstore_datashare_bridge.cpp",
    ]
  }

  kvdb_sources = [
    "../../kvdb/src/backup_manager.cpp",
    "../../kvdb/src/convertor.cpp",
    "../../kvdb/src/kv_types_util.cpp",
    "../../kvdb/src/kvdb_service_client.cpp",
    "../../kvdb/src/observer_bridge.cpp",
    "../../kvdb/src/process_communication_impl.cpp",
    "../../kvdb/src/process_system_api_adapter_impl.cpp",
    "../../kvdb/src/security_manager.cpp",
    "../../kvdb/src/single_store_impl.cpp",
    "../../kvdb/src/store_factory.cpp",
    "../../kvdb/src/store_manager.cpp",
    "../../kvdb/src/store_result_set.cpp",
    "../../kvdb/src/store_util.cpp",
    "../../kvdb/src/system_api.cpp",
    "../../kvdb/src/task_executor.cpp",
    "../../kvdb/src/task_executor_adapter.cpp",
  ]

  sources = old_sources + kvdb_sources
  configs = [ ":module_private_config" ]

  deps = [
    "../../../../databaseutils:database_utils",
    "../../../../interfaces/innerkits/distributeddatamgr:distributeddata_mgr",
    "//foundation/distributeddatamgr/kv_store/frameworks/libs/distributeddb:distributeddb",
  ]
  deps += deps_access_token_libaccesstoken_sdk
  deps += deps_access_token_libtokenid_sdk
  deps += deps_file_api
  deps += deps_hilog
  deps += deps_hisysevent
  deps += deps_hitrace_meter
  deps += deps_hitrace_chain
  deps += deps_huks
  deps += deps_ipc_single
  deps += deps_samgr

  external_deps = [
    "c_utils:utils",
  ]
  external_deps += external_deps_access_token_libaccesstoken_sdk
  external_deps += external_deps_access_token_libtokenid_sdk
  external_deps += external_deps_file_api
  external_deps += external_deps_hilog
  external_deps += external_deps_hisysevent
  external_deps += external_deps_hitrace_meter
  external_deps += external_deps_hitrace_chain
  external_deps += external_deps_huks
  external_deps += external_deps_ipc_single
  external_deps += external_deps_samgr

  if (data_share_enabled) {
    external_deps += [
      "data_share:datashare_common",
      "data_share:datashare_provider",
    ]
  }

  if (dms_service_enable && qemu_disable) {
    sources += [ "${kv_store_base_path}/frameworks/innerkitsimpl/kvdb/src/auto_sync_timer.cpp" ]
    external_deps += external_deps_dmsfwk
    deps += deps_dmsfwk
  } else {
    sources += [ "${kv_store_base_path}/frameworks/innerkitsimpl/kvdb/src/auto_sync_timer_mock.cpp" ]
  }
  if (dm_service_enable) {
    sources += [
      "${kv_store_base_path}/frameworks/innerkitsimpl/kvdb/src/dev_manager.cpp",
      "${kv_store_base_path}/frameworks/innerkitsimpl/kvdb/src/device_convertor.cpp",
    ]
  } else {
    sources += [
      "${kv_store_base_path}/frameworks/innerkitsimpl/kvdb/src/dev_manager_mock.cpp",
      "${kv_store_base_path}/frameworks/innerkitsimpl/kvdb/src/device_convertor_mock.cpp",
    ]
  }

  subsystem_name = "distributeddatamgr"
  part_name = "kv_store"
}

